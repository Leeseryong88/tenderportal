# ==============================================================================
# IICOMBINED Tender Portal - Environment Variables Template
# Copy to .env.local for local Emulator development. NEVER commit real secrets.
# ==============================================================================

# --- Client (Public Firebase Web Config) ---
# Source: Firebase Console -> Project settings -> Your apps -> Web app
# Note: Public client identifiers; access control is enforced by Server API & Rules.
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-iicombined-tender
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-iicombined-tender.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:placeholder

# Optional: Firebase App Check (reCAPTCHA Enterprise / v3 site key)
# Source: Firebase Console -> App Check -> Web app
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=

# Optional: Google Sign-In button visibility ('true' to enable)
NEXT_PUBLIC_ENABLE_GOOGLE_LOGIN=false

# Default tenant ID for single-organization deployment
NEXT_PUBLIC_DEFAULT_TENANT_ID=iicombined

# --- Local Emulator Flags (Development / Test ONLY; leave false/unset in Preview & Production) ---
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# --- Server-Only (NEVER prefix with NEXT_PUBLIC_) ---
# Source: Firebase Console -> Project settings -> Service accounts -> Generate new private key
# (Or configure Vercel OIDC / Workload Identity Federation in Production)
FIREBASE_PROJECT_ID=demo-iicombined-tender
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@demo-iicombined-tender.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=demo-iicombined-tender.firebasestorage.app

# Server Emulator connections (Development / Test ONLY)
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Application Origin & CSRF Protection
# Source: Vercel deployment URL / custom domain
APP_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Session Cookie Name & Security
SESSION_COOKIE_NAME=__session

# Optional: Require App Check token on sensitive API endpoints in production ('true' | 'false')
REQUIRE_APP_CHECK=false

# Operator CLI Bootstrap / Seed Safety
# Seed script refuses to run if NODE_ENV=production unless ALLOW_NON_EMULATOR_SEED=true is intentionally set for staging.
ALLOW_NON_EMULATOR_SEED=false
